# ── Database ──────────────────────────────────────────────────────────────────
# Vercel Postgres / Supabase / Neon connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/propvault?sslmode=require"

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Found in Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="propvault"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com — for invite and password-reset emails
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@yourdomain.com"
