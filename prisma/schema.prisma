generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

enum TagSource {
  human
  ai_pending
  ai_approved
}

// ── Auth.js required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(user)
  isActive      Boolean   @default(true)
  invitedById   String?
  createdAt     DateTime  @default(now())

  invitedBy   User?  @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers User[] @relation("UserInvites")

  accounts     Account[]
  sessions     Session[]
  albums       Album[]
  photos       Photo[]
  productTags  ProductTag[]
  likes        Like[]
  comments     Comment[]
  sentInvites  Invite[]
  monthlyWinnersPicked MonthlyWinner[]
  monthlyNominations   MonthlyNominee[]
}

model Album {
  id           String   @id @default(cuid())
  name         String
  monthYear    String?  @unique // e.g. "2026-06"; null for any legacy manual albums
  description  String?
  coverPhotoId String?
  createdById  String
  createdAt    DateTime @default(now())

  createdBy  User    @relation(fields: [createdById], references: [id])
  coverPhoto Photo?  @relation("AlbumCover", fields: [coverPhotoId], references: [id])
  photos     Photo[] @relation("AlbumPhotos")
}

model Photo {
  id               String   @id @default(cuid())
  originalFilename String
  storageKey       String   @unique
  fileSize         Int
  mimeType         String
  albumId          String
  uploadedById     String
  uploadedAt       DateTime @default(now())
  isDeleted        Boolean  @default(false)
  takenAt          DateTime? // from EXIF DateTimeOriginal; falls back to uploadedAt
  locationName     String?   // reverse-geocoded city/area e.g. "Frisco" or "Dallas"
  locationLat      Float?    // raw GPS latitude
  locationLng      Float?    // raw GPS longitude
  mediaType        String   @default("photo") // "photo" or "video"

  album           Album           @relation("AlbumPhotos", fields: [albumId], references: [id])
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
  productTags     ProductTag[]
  likes           Like[]
  comments        Comment[]
  albumCovers     Album[]         @relation("AlbumCover")
  monthlyWinner   MonthlyWinner?
  monthlyNominees MonthlyNominee[]
}

model ProductTag {
  id        String    @id @default(cuid())
  photoId   String
  code      String
  addedById String
  source    TagSource @default(human)
  createdAt DateTime  @default(now())

  photo   Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  addedBy User  @relation(fields: [addedById], references: [id])

  @@index([photoId])
  @@index([code])
}

model Like {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime

  invitedBy User @relation(fields: [invitedById], references: [id])
}

model MonthlyWinner {
  id          String   @id @default(cuid())
  photoId     String   @unique
  month       String   // "2026-06"
  category    String   // "photo" or "video"
  pickedById  String
  pickedAt    DateTime @default(now())
  notes       String?

  photo       Photo    @relation(fields: [photoId], references: [id])
  pickedBy    User     @relation(fields: [pickedById], references: [id])
}

model MonthlyNominee {
  id         String   @id @default(cuid())
  photoId    String
  month      String   // "2026-06"
  nominatedById String
  nominatedAt  DateTime @default(now())

  photo        Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  nominatedBy  User   @relation(fields: [nominatedById], references: [id])

  @@unique([photoId, month])
}
